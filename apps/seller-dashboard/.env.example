# Cognito Authentication
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_API_URL=
# Product Intelligence API base URL (AI synthesis engine — separate HTTP API).
# Value is the SSM export /merch-os/{env}/product-intelligence/api-url.
NEXT_PUBLIC_INTELLIGENCE_API_URL=
# Export API base URL (validate + export pipeline — separate HTTP API).
# Value is the SSM export /merch-os/{env}/export-api/url.
NEXT_PUBLIC_EXPORT_API_URL=
# Billing API base URL (subscriptions, credits, PayFast checkout — separate HTTP API).
# Value is the SSM export /merch-os/{env}/billing-api/url.
NEXT_PUBLIC_BILLING_API_URL=
# Per-service API base URLs (each MerchOS service is its own HTTP API).
# Values are the SSM exports /merch-os/{env}/<service>/... or the stack outputs.
NEXT_PUBLIC_PRODUCT_API_URL=
NEXT_PUBLIC_SUPPLIER_API_URL=
NEXT_PUBLIC_INVENTORY_API_URL=
NEXT_PUBLIC_IMAGE_API_URL=
# Set to 'true' ONLY when plan prices are final: shows Subscribe/Upgrade and the
# voucher field. Must be paired with `--context checkoutEnabled=true` on the
# Billing API stack (the API refuses checkouts otherwise).
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false
# Live chat (SupportChat stack). SSM exports /merch-os/{env}/support-chat/api-url
# and /merch-os/{env}/support-chat/ws-url. The bubble only shows when both are set
# AND either ENABLED=true or the browser opted in with ?chat=preview (?chat=off undoes).
NEXT_PUBLIC_SUPPORT_CHAT_API_URL=
NEXT_PUBLIC_SUPPORT_CHAT_WS_URL=
NEXT_PUBLIC_SUPPORT_CHAT_ENABLED=false
NEXT_PUBLIC_REDIRECT_SIGN_IN=http://localhost:3000/callback
NEXT_PUBLIC_REDIRECT_SIGN_OUT=http://localhost:3000/login
