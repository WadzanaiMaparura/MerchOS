# Admin Cognito Authentication (operator pool — isolated from seller env vars)
NEXT_PUBLIC_ADMIN_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_ADMIN_COGNITO_CLIENT_ID=
NEXT_PUBLIC_ADMIN_COGNITO_DOMAIN=
NEXT_PUBLIC_ADMIN_REDIRECT_SIGN_IN=http://localhost:3001/callback
NEXT_PUBLIC_ADMIN_REDIRECT_SIGN_OUT=http://localhost:3001/login

# MerchOS API Gateway base URL — serves the admin /auth/* user-management
# endpoints (and other /admin/* resources) consumed by the api-client hooks.
NEXT_PUBLIC_ADMIN_API_URL=

# Demo / sample-data mode.
#   Unset or any value except "false"  -> sample data fills empty pages (for
#                                          demos before the backend is wired),
#                                          with a persistent "Sample data" banner.
#   "false"                            -> live data only; empty pages show their
#                                          real loading / error / empty states.
# Set to "false" (or remove the line) once the backend is connected at launch.
NEXT_PUBLIC_ADMIN_DEMO_MODE=true
