# Dependencies
node_modules/

# Build output
dist/
.next/
out/

# TypeScript build output (services)
services/**/*.js
services/**/*.d.ts
services/**/*.js.map
packages/**/*.d.ts
packages/**/*.js.map

# Config files that should be kept
!jest.config.js
!next.config.js
!vitest.config.ts
!cdk.json
!tailwind.config.ts
!postcss.config.js

# CDK
cdk.out/
.cdk.staging/
# CDK deploy/diff logs (transient)
infrastructure/cdk-deploy-*.log
infrastructure/cdk-diff-*.log

# Secrets / signing keys — NEVER commit. The image signed-URL private key
# lives in Secrets Manager; the public key is in cdk.context.json.
.img-signing-private.pem
.img-signing-public.pem
*.pem

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Turbo
.turbo/

# Coverage
coverage/

# Lock files (keep package-lock.json, ignore others)
yarn.lock
pnpm-lock.yaml
