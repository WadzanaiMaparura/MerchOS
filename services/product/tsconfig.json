{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "repository/**/*.ts",
    "service/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "repository/__tests__"
  ]
}
