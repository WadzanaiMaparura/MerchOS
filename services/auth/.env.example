# AWS Cognito
COGNITO_TENANT_POOL_ID=
COGNITO_ADMIN_POOL_ID=
COGNITO_SELLER_CLIENT_ID=
COGNITO_ISSUER=https://cognito-idp.af-south-1.amazonaws.com/{poolId}

# DynamoDB Tables
