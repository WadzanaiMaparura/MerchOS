{
  "name": "@merch-os/auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "Authentication and authorization service for the MerchOS platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir __tests__/unit",
    "test:integration": "vitest run --dir __tests__/integration"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.654.0",
    "@aws-sdk/client-eventbridge": "3.654.0",
    "@aws-sdk/client-dynamodb": "3.654.0",
    "@aws-sdk/lib-dynamodb": "3.654.0",
    "@aws-lambda-powertools/logger": "2.7.0",
    "@aws-lambda-powertools/tracer": "2.7.0",
    "@middy/core": "5.4.7",
    "zod": "3.23.8",
    "@merch-os/types": "*",
    "@merch-os/rbac": "*"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.140",
    "aws-sdk-client-mock": "4.0.1",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
