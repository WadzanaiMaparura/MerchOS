{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "api/**/*.ts",
    "config/**/*.ts",
    "providers/**/*.ts",
    "services/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "api/__tests__",
    "providers/__tests__",
    "services/__tests__"
  ]
}
