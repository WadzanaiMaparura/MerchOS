{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["engine/**/*.ts", "api/**/*.ts", "delivery/**/*.ts", "channels/**/*.ts", "data/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "engine/__tests__",
    "api/__tests__",
    "delivery/__tests__",
    "channels/__tests__",
    "data/__tests__"
  ]
}
