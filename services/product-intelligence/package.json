{
  "name": "@merch-os/product-intelligence-service",
  "version": "0.1.0",
  "private": true,
  "description": "Product Intelligence Engine — AI-powered content generation, optimization, and validation for MerchOS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir __tests__/unit",
    "test:integration": "vitest run --dir __tests__/integration",
    "test:properties": "vitest run --dir __tests__/properties"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.654.0",
    "@aws-sdk/client-dynamodb": "3.654.0",
    "@aws-sdk/lib-dynamodb": "3.654.0",
    "@aws-sdk/client-eventbridge": "3.654.0",
    "@aws-lambda-powertools/logger": "2.7.0",
    "@aws-lambda-powertools/metrics": "2.7.0",
    "@aws-lambda-powertools/tracer": "2.7.0",
    "@middy/core": "5.4.7",
    "zod": "3.23.8",
    "@merch-os/types": "*",
    "@merch-os/rbac": "*"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.140",
    "aws-sdk-client-mock": "4.0.1",
    "fast-check": "3.19.0",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
